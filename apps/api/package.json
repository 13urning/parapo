{
  "name": "@parapo/api",
  "version": "1.0.0",
  "private": true,
  "description": "ParaPo API (NestJS + Prisma)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/src/main.js",
    "start:container": "prisma migrate deploy && node dist/prisma/seed.js && node dist/src/main.js",
    "seed": "node dist/prisma/seed.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "multer": "2.5.0",
    "deepmerge-ts": "8.0.2"
  }
}
