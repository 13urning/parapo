# Required (API refuses to start without it)
DATABASE_URL=postgresql://parapo:parapo@localhost:5432/parapo?schema=public

# Optional. If unset, JWT_SECRET / VAPID keys are generated on first boot and stored in the AppSecret table.
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@parapo.local

PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=false
NOMINATIM_USER_AGENT=ParaPo/1.0 (tech exam)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
